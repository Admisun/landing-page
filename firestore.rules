rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function validSubmissionCreate() {
      let data = request.resource.data;
      return data.keys().hasAll(['uid', 'status', 'createdAt'])
        && data.status == 'pending'
        && (
          (request.auth != null && data.uid == request.auth.uid)
          || data.uid == 'anonymous'
        );
    }

    match /users/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    match /admission_submissions/{submissionId} {
      allow create: if validSubmissionCreate();

      allow read: if resource.data.uid == "anonymous"
        || (request.auth != null
            && resource.data.uid == request.auth.uid);

      allow update: if resource.data.uid == "anonymous"
        || (request.auth != null
            && resource.data.uid == request.auth.uid);
    }

    match /parsed_resumes/{resumeId} {
      allow create: if true;

      allow read: if (
        get(/databases/$(database)/documents/admission_submissions/$(resource.data.submissionId)).data.uid == "anonymous"
      ) || (
        request.auth != null &&
        get(/databases/$(database)/documents/admission_submissions/$(resource.data.submissionId)).data.uid == request.auth.uid
      );

      allow update: if false;
      allow delete: if false;
    }
  }
}
